{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Atlas Docs",
  "basePath": "/docs",
  "favicon": "/favicons/favicon.ico",
  "appearance": {
    "default": "system"
  },
  "colors": {
    "primary": "#c2956a",
    "light": "#d4b896",
    "dark": "#a67b50"
  },
  "feedback": {
    "thumbsRating": true
  },
  "redirects": [
    {
      "source": "/product/overview",
      "destination": "/what-is-atlas"
    },
    {
      "source": "/introduction",
      "destination": "/what-is-atlas"
    },
    {
      "source": "/migration",
      "destination": "/what-is-atlas"
    },
    {
      "source": "/mcp",
      "destination": "/mcp/overview"
    },
    {
      "source": "/mcp/claude-desktop",
      "destination": "/mcp/overview"
    },
    {
      "source": "/mcp/claude-code",
      "destination": "/mcp/overview"
    },
    {
      "source": "/mcp/vscode-copilot",
      "destination": "/mcp/overview"
    },
    {
      "source": "/mcp/gemini",
      "destination": "/mcp/overview"
    },
    {
      "source": "/mcp/codex",
      "destination": "/mcp/overview"
    },
    {
      "source": "/mcp/copilot-cli",
      "destination": "/mcp/overview"
    },
    {
      "source": "/mcp/other-clients",
      "destination": "/mcp/overview"
    },
    {
      "source": "/mcp/integration-monitoring",
      "destination": "/workspace/integration-activity"
    },
    {
      "source": "/api/overview",
      "destination": "/api"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Use Atlas",
        "groups": [
          {
            "group": "Introduction",
            "pages": ["what-is-atlas", "quickstart-learn"]
          },
          {
            "group": "Public discovery",
            "pages": [
              "quickstart-browse",
              "resources/trust",
              "how-it-works",
              "taxonomy",
              "resources/data-model"
            ]
          },
          {
            "group": "Use cases",
            "pages": [
              "use-cases/journalists",
              "use-cases/organizers",
              "use-cases/civic-teams",
              "use-cases/documentary"
            ]
          }
        ]
      },
      {
        "tab": "Team workflows",
        "groups": [
          {
            "group": "Workspaces",
            "pages": ["workspace/customer-workflow", "account/pricing"]
          },
          {
            "group": "Research patterns",
            "pages": [
              "use-cases/civic-teams",
              "use-cases/journalists",
              "use-cases/organizers",
              "resources/trust"
            ]
          }
        ]
      },
      {
        "tab": "Build with Atlas",
        "groups": [
          {
            "group": "API",
            "pages": [
              "api",
              "api/quickstart",
              "api/reference",
              "api/guides/entities",
              "api/guides/places",
              "api/guides/discovery",
              "api/guides/sources-flags",
              "api/guides/workspace",
              "api/guides/taxonomy",
              "api/typescript-sdk",
              "api/authentication",
              "api/rate-limits",
              "api/errors"
            ]
          },
          {
            "group": "Scout CLI",
            "pages": [
              "scout/overview",
              "scout/install",
              "scout/setup",
              "scout/run",
              "scout/articles",
              "scout/review-sync",
              "scout/worker",
              "scout/troubleshooting"
            ]
          },
          {
            "group": "MCP and agents",
            "pages": [
              "mcp/overview",
              "mcp/registry",
              "mcp/tools",
              "mcp/resources",
              "mcp/prompts",
              "mcp/elicitation",
              "mcp/scopes",
              "mcp/troubleshooting"
            ]
          },
          {
            "group": "Workspace access",
            "pages": ["workspace/integration-activity"]
          },
          {
            "group": "Tutorials",
            "pages": [
              "mcp/tutorials/research-city",
              "mcp/tutorials/agent-workflow"
            ]
          },
          {
            "group": "Open source",
            "pages": [
              "use-cases/developers",
              "self-hosting/guide",
              "resources/open-source",
              "resources/contributing"
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "resources/data-model",
              "resources/glossary",
              "resources/faq",
              "resources/troubleshooting"
            ]
          },
          {
            "group": "Project",
            "pages": ["resources/changelog", "resources/open-source"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Repository",
          "href": "https://github.com/RebuildingAmerica/atlas",
          "icon": "github"
        },
        {
          "anchor": "API reference",
          "href": "/api/reference",
          "icon": "code"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Atlas",
        "href": "https://atlas.rebuildingus.org"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/RebuildingAmerica/atlas"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/RebuildingAmerica/atlas"
    }
  }
}
