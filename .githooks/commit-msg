#!/bin/bash
set -euo pipefail

# Color codes (disabled when not in TTY to prevent escape sequence leakage)
if [[ -t 1 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  BLUE='\033[0;34m'
  NC='\033[0m'
else
  RED=''
  GREEN=''
  YELLOW=''
  BLUE=''
  NC=''
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
COMMIT_MSG_FILE="$1"
FORMATTER="$REPO_ROOT/scripts/validation/format-commit-message.sh"

if [[ -x "$FORMATTER" ]]; then
    FORMATTER_OUTPUT="$("$FORMATTER" "$COMMIT_MSG_FILE" 2>&1)"
    if [[ -n "$FORMATTER_OUTPUT" ]]; then
        echo "$FORMATTER_OUTPUT"
    fi
fi

COMMIT_HEADER=$(head -n 1 "$COMMIT_MSG_FILE")

if [[ "$COMMIT_HEADER" =~ ^(Merge|Revert[[:space:]]|fixup!|squash!) ]]; then
    exit 0
fi

# Conventional Commits pattern
# Format: type(scope)?: message
# Scopes are optional, but when present they must use an approved repo term.
# Descriptions must start with sentence case.
PATTERN='^(feat|fix|docs|chore|refactor)(\((api|app|scout|docs|dx)\))?!?: [A-Z0-9].+'

if ! echo "$COMMIT_HEADER" | grep -qE "$PATTERN"; then
    echo -e "\n${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}✗ Commit message does not follow Conventional Commits${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

    echo "Your message: ${YELLOW}$COMMIT_HEADER${NC}"
    echo ""
    echo "Format: ${BLUE}type(scope)?: message${NC}"
    echo ""
    echo "Valid types:"
    echo "  - ${BLUE}feat${NC}:     Consumer-facing capability added to the product"
    echo "  - ${BLUE}fix${NC}:      Consumer-facing bug fix in shipped behavior"
    echo "  - ${BLUE}docs${NC}:     Documentation-only changes"
    echo "  - ${BLUE}chore${NC}:    Documentation, tests, tooling, dependencies, or internal maintenance"
    echo "  - ${BLUE}refactor${NC}: Internal code reshaping with no behavior change"
    echo ""
    echo "Valid scopes (optional):"
    echo "  - ${BLUE}api${NC}:         Python/FastAPI application code"
    echo "  - ${BLUE}app${NC}:         React/TanStack Start application code"
    echo "  - ${BLUE}scout${NC}:       Atlas Scout autonomous discovery CLI"
    echo "  - ${BLUE}docs${NC}:        Documentation files"
    echo "  - ${BLUE}dx${NC}:          Developer experience, tooling, deployment, CI/CD"
    echo "  Use no scope for broad or cross-cutting changes."
    echo ""
    echo "Examples:"
    echo "  ${BLUE}feat(app): Add browse experience for issue areas${NC}"
    echo "  ${BLUE}fix(api): Return correct pagination metadata${NC}"
    echo "  ${BLUE}docs: Clarify local development workflow${NC}"
    echo "  ${BLUE}chore(dx): Improve setup guidance for junior developers${NC}"
    echo "  ${BLUE}refactor(scout): Simplify deduplication helpers${NC}"
    echo ""

    exit 1
fi

is_footer_line() {
    local line="$1"
    [[ "$line" =~ ^(BREAKING[[:space:]]CHANGE:|[A-Za-z][A-Za-z-]*:|Fixes[[:space:]]#|Closes[[:space:]]#|Related[[:space:]]to[[:space:]]#|Refs:|Co-Authored-By:|Co-authored-by:|Signed-off-by:|Reviewed-by:|Acked-by:) ]]
}

is_fence_line() {
    local line="$1"
    local trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ "$trimmed" == '```'* || "$trimmed" == '~~~'* ]]
}

validate_body_line_length() {
    local line=""
    local line_number=0
    local in_fence=0
    local failed=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        line_number=$((line_number + 1))

        if [[ $line_number -eq 1 ]]; then
            continue
        fi

        if is_fence_line "$line"; then
            if [[ $in_fence -eq 0 ]]; then
                in_fence=1
            else
                in_fence=0
            fi
            continue
        fi

        if [[ $in_fence -eq 1 || -z "$line" || "$line" == \#* ]]; then
            continue
        fi

        if is_footer_line "$line"; then
            continue
        fi

        if [[ ${#line} -gt 72 ]]; then
            if [[ $failed -eq 0 ]]; then
                echo ""
                echo "Commit body lines must be 72 characters or fewer."
            fi
            echo "  Line $line_number is ${#line} characters: $line"
            failed=1
        fi
    done < "$COMMIT_MSG_FILE"

    if [[ $failed -ne 0 ]]; then
        exit 1
    fi
}

validate_body_line_length

exit 0
