# ============================================
# The Atlas - Staging Environment Configuration
# ============================================
# Staging uses hosted Atlas origins with Stripe test-mode objects.

ATLAS_PUBLIC_URL=https://atlas-staging.rebuildingus.org
ATLAS_API_URL=https://atlas-api-staging.rebuildingus.org
ATLAS_DOCS_URL=https://your-subdomain.mintlify.dev
# Does the Rebuilding America Project run this instance? Controls whether
# Atlas's own billing catalog and staff review authority apply.
ATLAS_MANAGED=true
# Does this instance have accounts? False means one operator, no sign-in.
ATLAS_MULTI_USER=true
ATLAS_AUTH_JWT_AUDIENCES=https://atlas-staging.rebuildingus.org/mcp,https://atlas-api-staging.rebuildingus.org

ENVIRONMENT=staging
LOG_LEVEL=info
DATABASE_BACKEND=postgres
ENABLE_OPENAPI_SPEC=true
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/atlas-staging?sslmode=require

ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
SEARCH_API_KEY=

ATLAS_AUTH_API_KEY_INTROSPECTION_URL=https://atlas-staging.rebuildingus.org/api/auth/internal/api-key
ATLAS_AUTH_MEMBERSHIP_URL=https://atlas-staging.rebuildingus.org
ATLAS_AUTH_INTERNAL_SECRET=replace-with-a-long-random-secret
# Anyone may create an account. Set to "false" to restrict sign-up to the
# operator allowlist and pending invitations.
ATLAS_AUTH_OPEN_REGISTRATION=true
ATLAS_OPERATOR_ALLOWED_EMAILS=

ATLAS_EMAIL_PROVIDER=resend
ATLAS_EMAIL_FROM=Atlas <hello@atlas.rebuildingus.org>
ATLAS_EMAIL_RESEND_API_KEY=replace-with-your-resend-api-key
ATLAS_EMAIL_CAPTURE_URL=

ATLAS_SERVER_API_PROXY_TARGET=https://atlas-api-staging.rebuildingus.org

# Stripe — `pnpm setup:staging` fills these from Stripe test mode.
STRIPE_API_KEY=sk_test_replace_with_your_test_secret_or_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_staging_webhook_secret
STRIPE_ATLAS_CATALOG=

CORS_ORIGINS=["https://atlas-staging.rebuildingus.org"]
