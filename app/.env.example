# Example shape only. `make setup` writes the concrete local values to
# app/.env.local for host-based development.

# Deployment mode. Leave unset (or empty) for the default multi-user dev
# stack — `pnpm dev` runs that flow with auth, sign-up, and Stripe enabled.
# Set to "local" to run a single-user, auth-disabled local stack — most
# easily started with `pnpm dev:local`, which exports this for you.
ATLAS_DEPLOY_MODE=

ATLAS_PUBLIC_URL=https://atlas.localhost
ATLAS_API_AUDIENCE=https://atlas.localhost/mcp,https://api.atlas.localhost
# Docs origin. In dev this is the portless-routed local mint dev server.
# In prod, set to the Mintlify deployment origin (e.g. https://your-subdomain.mintlify.dev).
ATLAS_DOCS_URL=https://docs.atlas.localhost

# Vite dev server proxy target for non-auth API routes.
ATLAS_DEV_API_PROXY_TARGET=https://api.atlas.localhost
# Server-side API target for SSR loaders and server functions.
ATLAS_SERVER_API_PROXY_TARGET=https://api.atlas.localhost
ATLAS_ANON_RATE_LIMIT_ENABLED=true
ATLAS_ANON_RATE_LIMIT_READS_PER_MINUTE=30
ATLAS_ANON_RATE_LIMIT_WRITES_PER_MINUTE=10
ATLAS_ANON_RATE_LIMIT_TOTAL_PER_HOUR=120
ATLAS_TRUSTED_PROXY_HOPS=1

ATLAS_AUTH_BASE_PATH=/api/auth
# Required when ATLAS_DEPLOY_MODE is not "local".
ATLAS_AUTH_INTERNAL_SECRET=replace-with-a-local-secret-if-you-enable-auth
ATLAS_AUTH_API_KEY_INTROSPECTION_URL=https://atlas.localhost/api/auth/internal/api-key
ATLAS_AUTH_MEMBERSHIP_URL=https://atlas.localhost

# Comma-separated allowlist of SAML IdP issuer URLs (matched by origin).
# Required to register any workspace SAML provider; empty list denies all
# SAML registrations.
ATLAS_SAML_ALLOWED_ISSUERS=

# Optional PEM-encoded SP private key used to sign outbound SAML AuthnRequests.
# When set, new SAML registrations flip authnRequestsSigned: true.
ATLAS_SAML_SP_PRIVATE_KEY=
ATLAS_SAML_SP_PRIVATE_KEY_PASS=
ATLAS_EMAIL_PROVIDER=capture
ATLAS_EMAIL_FROM=Atlas <hello@atlas.localhost>
# The capture server (pnpm run e2e:mail) is proxied through portless — use the .localhost URL.
ATLAS_EMAIL_CAPTURE_URL=https://mail.atlas.localhost/messages
ATLAS_EMAIL_RESEND_API_KEY=
