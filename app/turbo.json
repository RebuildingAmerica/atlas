    "test:unit:system": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "scripts/unit-test-shards.ts",
        "src/components/**",
        "src/lib/**",
        "src/platform/**",
        "src/routes/[.]well-known/**",
        "src/routes/api/**",
        "src/routes/device/**",
        "src/routes/docs.tsx",
        "src/routes/docs/**",
        "src/routes/health.ts",
        "src/routes/llms[.]txt.ts",
        "src/routes/openapi[.]json.ts",
        "src/routes/robots[.]txt.ts",
        "src/routes/sitemap[.]xml.ts",
        "src/styles/**",
        "tests/helpers/**",
        "tests/setup.ts",
        "tests/unit/acceptance/**",
        "tests/unit/routes/[.]well-known/**",
        "tests/unit/routes/api/$.test.ts",
        "tests/unit/routes/api/health.test.ts",
        "tests/unit/routes/device/**",
        "tests/unit/routes/docs.test.ts",
        "tests/unit/routes/docs/**",
        "tests/unit/routes/health.test.ts",
        "tests/unit/routes/llms-txt.test.ts",
        "tests/unit/routes/openapi-json.test.ts",
        "tests/unit/routes/robots-txt.test.ts",
        "tests/unit/routes/sitemap-xml.test.ts",
        "tests/unit/scripts/**"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "env": [
        "ATLAS_E2E_API_URL",
        "ATLAS_E2E_APP_URL",
        "ATLAS_E2E_AUTH_INTROSPECTION_URL",
        "ATLAS_SCOUT_E2E_FILE_CREDENTIAL_STORE",
        "ATLAS_E2E_MAILBOX_URL"
      ],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },
    "test:e2e:headed": {
      "dependsOn": ["^build"],
      "env": [
        "ATLAS_E2E_API_URL",
        "ATLAS_E2E_APP_URL",
        "ATLAS_E2E_AUTH_INTROSPECTION_URL",
        "ATLAS_SCOUT_E2E_FILE_CREDENTIAL_STORE",
        "ATLAS_E2E_MAILBOX_URL"
      ],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },
    "test:acceptance": {
      "dependsOn": ["^build", "e2e:cleanup"],
      "env": [
        "ATLAS_E2E_API_URL",
        "ATLAS_E2E_APP_URL",
        "ATLAS_E2E_AUTH_INTROSPECTION_URL",
        "ATLAS_E2E_MAILBOX_URL",
        "ATLAS_E2E_WORKERS",
        "ATLAS_SCOUT_E2E_FILE_CREDENTIAL_STORE",
        "STRIPE_API_KEY",
        "STRIPE_ATLAS_CATALOG"
      ],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },
    "test:acceptance:browser": {
      "dependsOn": ["^build", "e2e:cleanup"],
      "env": [
        "ATLAS_E2E_API_URL",
        "ATLAS_E2E_APP_URL",
        "ATLAS_E2E_AUTH_INTROSPECTION_URL",
        "ATLAS_E2E_MAILBOX_URL",
        "ATLAS_E2E_WORKERS",
        "ATLAS_SCOUT_E2E_FILE_CREDENTIAL_STORE"
      ],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },
    "test:acceptance:stripe": {
      "dependsOn": ["^build", "e2e:cleanup"],
      "env": [
        "ATLAS_E2E_API_URL",
        "ATLAS_E2E_APP_URL",
        "ATLAS_E2E_AUTH_INTROSPECTION_URL",
        "ATLAS_E2E_MAILBOX_URL",
        "ATLAS_E2E_WORKERS",
        "ATLAS_SCOUT_E2E_FILE_CREDENTIAL_STORE",
        "STRIPE_API_KEY",
        "STRIPE_ATLAS_CATALOG"
      ],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
