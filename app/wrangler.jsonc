{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "atlas-app-candidate",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "secrets": { "required": ["ATLAS_AUTH_INTERNAL_SECRET"] },
  "vars": {
    "ATLAS_AUTH_MIGRATIONS": "external",
    "ATLAS_DOCS_URL": "",
    "ATLAS_SERVER_API_PROXY_TARGET": ""
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000", "localConnectionString": "postgres://atlas:atlas@127.0.0.1:5432/atlas" }]
}
