        "type": "http"
      }
    }
  },
  "defaultContentType": "application/json",
  "info": {
    "description": "Message contract for source-backed Firehose observations over Server-Sent Events and WebSockets.",
    "title": "Atlas Firehose Protocol",
    "version": "0.1.0"
  },
  "operations": {
    "receiveSessionFirehoseEvents": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/firehoseSessionEvents"
      },
      "messages": [
        {
          "$ref": "#/components/messages/FirehoseReady"
        },
        {
          "$ref": "#/components/messages/FirehoseSignalReceived"
        },
        {
          "$ref": "#/components/messages/FirehoseHeartbeat"
        }
      ]
    },
    "receiveSessionFirehoseSocketEvents": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/firehoseSessionSocket"
      },
      "messages": [
        {
          "$ref": "#/components/messages/FirehoseReady"
        },
        {
          "$ref": "#/components/messages/FirehoseSignalReceived"
        },
        {
          "$ref": "#/components/messages/FirehoseHeartbeat"
        }
      ]
    },
    "receiveTopLevelFirehoseEvents": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/firehoseQueryEvents"
      },
      "messages": [
        {
          "$ref": "#/components/messages/FirehoseReady"
        },
        {
          "$ref": "#/components/messages/FirehoseSignalReceived"
        },
        {
          "$ref": "#/components/messages/FirehoseHeartbeat"
        }
      ]
    }
  },
  "security": [
    {
      "apiKey": []
    },
    {
      "bearerJwt": []
    }
  ],
  "servers": {
    "atlasApi": {
      "host": "atlas.rebuildingus.org",
      "pathname": "/",
      "protocol": "https"
    }
  },
  "x-atlas": {
    "representations": [
      "application/json",
      "text/event-stream"
    ],
    "sseRetryMs": 3000,
    "websocketSubprotocol": "atlas.firehose.v1"
  }
}
