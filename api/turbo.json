{
  "extends": [
    "//"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "ATLAS_MANAGED",
        "ATLAS_MULTI_USER",
        "ATLAS_PUBLIC_URL",
        "DATABASE_BACKEND",
        "DATABASE_URL"
      ]
    },
    "setup": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "setup"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "pyproject.toml",
        "uv.lock"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": [
        "setup"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "pyproject.toml",
        "uv.lock"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "setup",
        "@rebuildingamerica/atlas-discovery-engine#test",
        "@rebuildingamerica/atlas-shared#test"
      ],
      "env": [
        "ATLAS_MANAGED",
        "ATLAS_MULTI_USER",
        "ATLAS_TEST_POSTGRES_URL"
      ],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/libs/discovery-engine/**",
        "$TURBO_ROOT$/libs/shared/**",
        "!*.pyc",
        "!**/__pycache__/**",
        "!.coverage",
        "!.coverage.*",
        "!.hypothesis/**",
        "!.mypy_cache/**",
        "!.pytest_cache/**",
        "!.ruff_cache/**",
        "!.venv/**",
        "!htmlcov/**",
        "!node_modules/**",
        "!**/.turbo/**",
        "!atlas.db",
        "!openapi/**",
        "!$TURBO_ROOT$/libs/**/*.pyc",
        "!$TURBO_ROOT$/libs/**/__pycache__/**",
        "!$TURBO_ROOT$/libs/**/.coverage",
        "!$TURBO_ROOT$/libs/**/.coverage.*",
        "!$TURBO_ROOT$/libs/**/.hypothesis/**",
        "!$TURBO_ROOT$/libs/**/.mypy_cache/**",
        "!$TURBO_ROOT$/libs/**/.pytest_cache/**",
        "!$TURBO_ROOT$/libs/**/.ruff_cache/**",
        "!$TURBO_ROOT$/libs/**/.venv/**",
        "!$TURBO_ROOT$/libs/**/htmlcov/**",
        "!$TURBO_ROOT$/libs/**/node_modules/**",
        "!$TURBO_ROOT$/libs/**/.turbo/**",
        "!$TURBO_ROOT$/libs/**/atlas.db"
      ]
    }
  }
}
