# Atlas API local environment

DATABASE_URL=sqlite:///atlas.db
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
SEARCH_API_KEY=
CORS_ORIGINS=["https://atlas.localhost"]
LOG_LEVEL=info
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8000
ENABLE_OPENAPI_SPEC=true
ATLAS_ANON_RATE_LIMIT_ENABLED=true
ATLAS_ANON_RATE_LIMIT_READS_PER_MINUTE=30
ATLAS_ANON_RATE_LIMIT_WRITES_PER_MINUTE=10
ATLAS_ANON_RATE_LIMIT_TOTAL_PER_HOUR=120
ATLAS_ANON_CREDENTIAL_RATE_LIMIT_PER_MINUTE=60
ATLAS_ANON_CREDENTIAL_RATE_LIMIT_TOTAL_PER_HOUR=600
ATLAS_TRUSTED_PROXY_HOPS=1
ATLAS_TRUST_UNSIGNED_FORWARD_HEADERS=false
ATLAS_EDGE_ORIGIN_SECRET=replace-with-a-local-edge-secret

# Deployment mode. Leave unset (or empty) for the default multi-user dev
# stack — `pnpm dev` from the repo root runs that flow with auth, sign-up,
# and Stripe enabled. Set to "local" to run a single-user, auth-disabled
# local stack — `pnpm dev:local` exports this for you.
# Does this instance have accounts? False means one operator, no sign-in.
ATLAS_MULTI_USER=true
# Does the Rebuilding America Project run this instance?
ATLAS_MANAGED=true

# Auth — required when ATLAS_MULTI_USER is true.
# ATLAS_API_AUDIENCE is the OAuth audience claim the API accepts. It may be
# comma-separated when distinct values must be issued for the REST API and the
# MCP endpoint per RFC 8707.
ATLAS_API_AUDIENCE=https://atlas.localhost/mcp,https://api.atlas.localhost
ATLAS_PUBLIC_URL=https://atlas.localhost
# Sent as X-Atlas-Callback-Secret when the API calls back into the app. Must
# match the app's value.
ATLAS_AUTH_CALLBACK_SECRET=replace-with-a-local-callback-secret
ATLAS_AUTH_API_KEY_INTROSPECTION_URL=https://atlas.localhost/api/auth/internal/api-key
ATLAS_AUTH_MEMBERSHIP_URL=https://atlas.localhost

# Machine callers — who may start the scheduled discovery run or deliver
# Firehose observations. A JSON list; empty means no machine is trusted. Each
# issuer names the actions it may take, nothing more.
#   google_oidc:  {"kind":"google_oidc","name":"cloud-scheduler",
#                  "service_account":"atlas-scheduler@<project>.iam.gserviceaccount.com",
#                  "audience":"https://atlas.example.org/api/discovery-runs/scheduled",
#                  "actions":["machine.runs.trigger_scheduled"]}
#   static_key:   for a self-hosted cron. Store only the key's SHA-256
#                 (`printf %s "$KEY" | shasum -a 256`); the cron sends
#                 `Authorization: Bearer $KEY`.
#                 {"kind":"static_key","name":"cron","key_sha256":"<64 hex>",
#                  "actions":["machine.runs.trigger_scheduled"]}
ATLAS_MACHINE_TRUSTED_ISSUERS=[]

# Platform admin — managed deployments only (ATLAS_MANAGED=true). The admin app
# calls /api/platform/* with its Ed25519 token (an ed25519_jwt issuer above)
# and the operator's forwarded Cloudflare Access sign-in, verified here against
# this team and application. Set both Access values or neither. Empty
# ATLAS_PLATFORM_OPERATOR_EMAILS means nobody may use the platform admin.
ATLAS_ACCESS_TEAM_DOMAIN=
ATLAS_ACCESS_AUD=
ATLAS_PLATFORM_OPERATOR_EMAILS=

# MCP widgets — rarely needed. Only set this if built widget assets don't
# live at either of resolve_widget_asset_dir()'s default locations (a
# production Docker-populated directory, or the monorepo dev build output).
ATLAS_MCP_WIDGET_ASSETS_DIR=
