{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "envMode": "strict",
  "globalEnv": [
    "ATLAS_DEPLOY_MODE",
    "ATLAS_PUBLIC_URL",
    "ATLAS_AUTH_JWT_AUDIENCES",
    "ATLAS_EMAIL_PROVIDER",
    "ATLAS_SERVER_API_PROXY_TARGET",
    "ATLAS_DOCS_URL",
    "ATLAS_AUTH_MEMBERSHIP_URL",
    "DATABASE_BACKEND"
  ],
  "globalPassThroughEnv": [
    "ATLAS_AUTH_API_KEY_INTROSPECTION_URL",
    "ATLAS_AUTH_INTERNAL_SECRET",
    "ATLAS_EMAIL_FROM",
    "ATLAS_EMAIL_RESEND_API_KEY",
    "DATABASE_URL",
    "STRIPE_API_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_ATLAS_CATALOG"
  ],
  "globalDependencies": [
    "pnpm-workspace.yaml",
    "package.json",
    "pnpm-lock.yaml",
    ".env.example"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".output/**", "dist/**"],
      "env": [
        "ATLAS_DEPLOY_MODE",
        "ATLAS_PUBLIC_URL",
        "ATLAS_AUTH_BASE_PATH",
        "ATLAS_AUTH_JWT_AUDIENCES",
        "ATLAS_DOCS_URL",
        "ATLAS_EMAIL_PROVIDER",
        "ATLAS_SERVER_API_PROXY_TARGET",
        "NITRO_PRESET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs#favicons": {
      "inputs": ["brand/**", "scripts/build-favicons.mjs", "package.json"],
      "outputs": ["favicons/**"]
    },
    "docs#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["docs#favicons"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "package.json",
        "pyproject.toml",
        "uv.lock"
      ],
      "env": ["ATLAS_DEPLOY_MODE"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "eslint.config.js",
        ".eslintrc.*",
        "pyproject.toml",
        "ruff.toml"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.ts",
        "pytest.ini",
        "pyproject.toml",
        "uv.lock"
      ],
      "env": [
        "DATABASE_URL",
        "ATLAS_DEPLOY_MODE",
        "ATLAS_AUTH_JWT_AUDIENCES",
        "ATLAS_AUTH_API_KEY_INTROSPECTION_URL",
        "ATLAS_AUTH_MEMBERSHIP_URL",
        "ATLAS_AUTH_INTERNAL_SECRET",
        "ENVIRONMENT",
        "LOG_LEVEL",
        "ATLAS_PUBLIC_URL"
      ]
    },
    "quality": {
      "dependsOn": ["typecheck", "lint", "test"]
    },
    "//#openapi": {
      "inputs": ["api/atlas/**/*.py", "api/pyproject.toml", "api/uv.lock"],
      "outputs": [
        "openapi/atlas.openapi.json",
        "mintlify/openapi/atlas.openapi.json"
      ],
      "env": [
        "ATLAS_DEPLOY_MODE",
        "NITRO_PRESET",
        "ATLAS_PUBLIC_URL",
        "ATLAS_AUTH_JWT_AUDIENCES",
        "ATLAS_DOCS_URL",
        "ATLAS_EMAIL_PROVIDER",
        "ATLAS_AUTH_BASE_PATH",
        "ATLAS_SERVER_API_PROXY_TARGET"
      ]
    },
    "@rebuildingamerica/atlas-shared#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!*.pyc",
        "!**/__pycache__/**",
        "!.coverage",
        "!.coverage.*",
        "!.hypothesis/**",
        "!.mypy_cache/**",
        "!.pytest_cache/**",
        "!.ruff_cache/**",
        "!.venv/**",
        "!htmlcov/**",
        "!node_modules/**"
      ],
      "env": []
    },
    "@rebuildingamerica/atlas-discovery-engine#test": {
      "dependsOn": ["@rebuildingamerica/atlas-shared#test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/libs/shared/**",
        "!*.pyc",
        "!**/__pycache__/**",
        "!.coverage",
        "!.coverage.*",
        "!.hypothesis/**",
        "!.mypy_cache/**",
        "!.pytest_cache/**",
        "!.ruff_cache/**",
        "!.venv/**",
        "!htmlcov/**",
        "!node_modules/**",
        "!$TURBO_ROOT$/libs/shared/**/*.pyc",
        "!$TURBO_ROOT$/libs/shared/**/__pycache__/**",
        "!$TURBO_ROOT$/libs/shared/.coverage",
        "!$TURBO_ROOT$/libs/shared/.coverage.*",
        "!$TURBO_ROOT$/libs/shared/.hypothesis/**",
        "!$TURBO_ROOT$/libs/shared/.mypy_cache/**",
        "!$TURBO_ROOT$/libs/shared/.pytest_cache/**",
        "!$TURBO_ROOT$/libs/shared/.ruff_cache/**",
        "!$TURBO_ROOT$/libs/shared/.venv/**",
        "!$TURBO_ROOT$/libs/shared/htmlcov/**",
        "!$TURBO_ROOT$/libs/shared/node_modules/**"
      ],
      "env": []
    },
    "@rebuildingamerica/atlas-scout#test": {
      "dependsOn": [
        "@rebuildingamerica/atlas-discovery-engine#test",
        "@rebuildingamerica/atlas-shared#test"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/libs/discovery-engine/**",
        "$TURBO_ROOT$/libs/shared/**",
        "!*.pyc",
        "!**/__pycache__/**",
        "!.coverage",
        "!.coverage.*",
        "!.hypothesis/**",
        "!.mypy_cache/**",
        "!.pytest_cache/**",
        "!.ruff_cache/**",
        "!.venv/**",
        "!htmlcov/**",
        "!node_modules/**",
        "!$TURBO_ROOT$/libs/**/*.pyc",
        "!$TURBO_ROOT$/libs/**/__pycache__/**",
        "!$TURBO_ROOT$/libs/**/.coverage",
        "!$TURBO_ROOT$/libs/**/.coverage.*",
        "!$TURBO_ROOT$/libs/**/.hypothesis/**",
        "!$TURBO_ROOT$/libs/**/.mypy_cache/**",
        "!$TURBO_ROOT$/libs/**/.pytest_cache/**",
        "!$TURBO_ROOT$/libs/**/.ruff_cache/**",
        "!$TURBO_ROOT$/libs/**/.venv/**",
        "!$TURBO_ROOT$/libs/**/htmlcov/**",
        "!$TURBO_ROOT$/libs/**/node_modules/**"
      ],
      "env": []
    },
    "@rebuildingamerica/atlas-api#test": {
      "dependsOn": [
        "@rebuildingamerica/atlas-discovery-engine#test",
        "@rebuildingamerica/atlas-shared#test"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/libs/discovery-engine/**",
        "$TURBO_ROOT$/libs/shared/**",
        "!*.pyc",
        "!**/__pycache__/**",
        "!.coverage",
        "!.coverage.*",
        "!.hypothesis/**",
        "!.mypy_cache/**",
        "!.pytest_cache/**",
        "!.ruff_cache/**",
        "!.venv/**",
        "!htmlcov/**",
        "!node_modules/**",
        "!openapi/**",
        "!$TURBO_ROOT$/libs/**/*.pyc",
        "!$TURBO_ROOT$/libs/**/__pycache__/**",
        "!$TURBO_ROOT$/libs/**/.coverage",
        "!$TURBO_ROOT$/libs/**/.coverage.*",
        "!$TURBO_ROOT$/libs/**/.hypothesis/**",
        "!$TURBO_ROOT$/libs/**/.mypy_cache/**",
        "!$TURBO_ROOT$/libs/**/.pytest_cache/**",
        "!$TURBO_ROOT$/libs/**/.ruff_cache/**",
        "!$TURBO_ROOT$/libs/**/.venv/**",
        "!$TURBO_ROOT$/libs/**/htmlcov/**",
        "!$TURBO_ROOT$/libs/**/node_modules/**"
      ],
      "env": []
    },
    "//#contract:test": {
      "dependsOn": ["//#openapi"],
      "inputs": [
        "api/**",
        "!api/.coverage",
        "!api/.coverage.*",
        "!api/.hypothesis/**",
        "!api/.mypy_cache/**",
        "!api/.pytest_cache/**",
        "!api/.ruff_cache/**",
        "!api/.venv/**",
        "!api/**/__pycache__/**",
        "!api/**/*.pyc",
        "!api/htmlcov/**",
        "!api/node_modules/**",
        "!api/openapi/**",
        "openapi/atlas.openapi.json"
      ]
    },
    "//#compose:validate": {
      "inputs": [
        "compose.yaml",
        ".env.production.example",
        ".env.example",
        "deploy/Caddyfile"
      ]
    },
    "//#secrets:scan": {
      "inputs": [
        ".secrets.baseline",
        ".env.example",
        ".env.production.example",
        "api/.env.example",
        "app/.env.example",
        "api/uv.lock",
        "package.json",
        ".githooks/pre-push"
      ]
    },
    "//#e2e:api": {
      "inputs": [
        "api/**",
        "!api/.coverage",
        "!api/.coverage.*",
        "!api/.hypothesis/**",
        "!api/.mypy_cache/**",
        "!api/.pytest_cache/**",
        "!api/.ruff_cache/**",
        "!api/.venv/**",
        "!api/**/__pycache__/**",
        "!api/**/*.pyc",
        "!api/htmlcov/**",
        "!api/node_modules/**",
        "!api/openapi/**",
        "openapi/atlas.openapi.json"
      ],
      "env": [
        "ANTHROPIC_API_KEY",
        "ATLAS_ATPROTO_OAUTH_E2E_HARNESS",
        "ATLAS_AUTH_JWT_AUDIENCES",
        "ATLAS_AUTH_API_KEY_INTROSPECTION_URL",
        "ATLAS_AUTH_MEMBERSHIP_URL",
        "ATLAS_AUTH_INTERNAL_SECRET",
        "ATLAS_DEPLOY_MODE",
        "ATLAS_PUBLIC_URL",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "DISCOVERY_JOB_WORKER_ENABLED",
        "ENABLE_OPENAPI_SPEC",
        "ENVIRONMENT",
        "LOG_LEVEL",
        "PORT",
        "SEARCH_API_KEY"
      ],
      "persistent": true
    }
  }
}
