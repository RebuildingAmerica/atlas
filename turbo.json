{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "envMode": "strict",
  "globalDependencies": [
    "pnpm-workspace.yaml",
    "package.json",
    "pnpm-lock.yaml",
    ".env.example"
  ],
  "tasks": {
    "//#openapi": {
      "inputs": ["api/atlas/**/*.py", "api/pyproject.toml", "api/uv.lock"],
      "outputs": [
        "openapi/atlas.openapi.json",
        "mintlify/openapi/atlas.openapi.json"
      ],
      "env": [
        "ATLAS_MANAGED",
        "ATLAS_MULTI_USER",
        "NITRO_PRESET",
        "ATLAS_PUBLIC_URL",
        "ATLAS_AUTH_JWT_AUDIENCES",
        "ATLAS_DOCS_URL",
        "ATLAS_EMAIL_PROVIDER",
        "ATLAS_AUTH_BASE_PATH",
        "ATLAS_SERVER_API_PROXY_TARGET",
        "ATLAS_AUTH_INTERNAL_SECRET",
        "ATLAS_AUTH_OPEN_REGISTRATION",
        "ATLAS_AUTH_API_KEY_INTROSPECTION_URL",
        "ATLAS_AUTH_MEMBERSHIP_URL"
      ]
    },
    "//#contract:test": {
      "dependsOn": ["//#openapi"],
      "inputs": [
        "api/**",
        "!api/.coverage",
        "!api/.coverage.*",
        "!api/.hypothesis/**",
        "!api/.mypy_cache/**",
        "!api/.pytest_cache/**",
        "!api/.ruff_cache/**",
        "!api/.venv/**",
        "!api/**/__pycache__/**",
        "!api/**/*.pyc",
        "!api/htmlcov/**",
        "!api/node_modules/**",
        "!api/.turbo/**",
        "!api/atlas.db",
        "!api/openapi/**",
        "openapi/atlas.openapi.json"
      ]
    },
    "//#compose:validate": {
      "inputs": [
        "compose.yaml",
        "services/atproto-pds/**",
        ".env.production.example",
        ".env.example",
        "deploy/Caddyfile"
      ]
    },
    "//#pds:test": {
      "inputs": [
        "services/atproto-pds/**",
        "scripts/deploy/pds-release.mjs",
        "scripts/deploy/pds-release.test.mjs"
      ]
    },
    "//#secrets:scan": {
      "inputs": [
        ".secrets.baseline",
        ".env.example",
        ".env.production.example",
        "api/.env.example",
        "app/.env.example",
        "api/uv.lock",
        "package.json",
        ".githooks/pre-push"
      ]
    },
    "//#e2e:api": {
      "inputs": [
        "api/**",
        "!api/.coverage",
        "!api/.coverage.*",
        "!api/.hypothesis/**",
        "!api/.mypy_cache/**",
        "!api/.pytest_cache/**",
        "!api/.ruff_cache/**",
        "!api/.venv/**",
        "!api/**/__pycache__/**",
        "!api/**/*.pyc",
        "!api/htmlcov/**",
        "!api/node_modules/**",
        "!api/.turbo/**",
        "!api/atlas.db",
        "!api/openapi/**",
        "openapi/atlas.openapi.json"
      ],
      "env": [
        "ANTHROPIC_API_KEY",
        "ATLAS_ATPROTO_OAUTH_E2E_HARNESS",
        "ATLAS_ATPROTO_PDS_E2E_HARNESS",
        "ATLAS_AUTH_JWT_AUDIENCES",
        "ATLAS_AUTH_API_KEY_INTROSPECTION_URL",
        "ATLAS_AUTH_MEMBERSHIP_URL",
        "ATLAS_AUTH_INTERNAL_SECRET",
        "ATLAS_AUTH_OPEN_REGISTRATION",
        "ATLAS_ANON_RATE_LIMIT_ENABLED",
        "ATLAS_MANAGED",
        "ATLAS_MULTI_USER",
        "ATLAS_PUBLIC_URL",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "DISCOVERY_JOB_WORKER_ENABLED",
        "ENABLE_OPENAPI_SPEC",
        "ENVIRONMENT",
        "LOG_LEVEL",
        "PORT",
        "SEARCH_API_KEY"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
