    "./entries/*": "./src/entries/*.tsx",
    "./search-state": "./src/search-state.ts",
    "./surface-model": "./src/surface-model.ts",
    "./taxonomy-domains": "./src/taxonomy-domains.ts",
    "./us-map": "./src/us-map.ts",
    "./us-state-grid": "./src/us-state-grid.ts",
    "./discovery/*": "./src/discovery/*.ts",
    "./discovery/brief-request": "./src/discovery/brief-request.ts",
    "./discovery/coverage-target-request": "./src/discovery/coverage-target-request.ts",
    "./discovery/page-utils": "./src/discovery/page-utils.ts",
    "./discovery/create-discovery-hooks": "./src/discovery/create-discovery-hooks.ts",
    "./discovery/components": "./src/discovery/components/index.ts",
    "./discovery/hooks/use-discovery": "./src/discovery/hooks/use-discovery.ts",
    "./firehose/feed-model": "./src/firehose/feed-model.ts",
    "./firehose/firehose-feed-page": "./src/firehose/firehose-feed-page.tsx",
    "./firehose/public-feed": "./src/firehose/public-feed.ts",
    "./firehose/rss": "./src/firehose/rss.ts",
    "./firehose/transport": "./src/firehose/transport.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./legacy/use-entries": "./src/legacy/use-entries.ts",
    "./legacy/use-taxonomy": "./src/legacy/use-taxonomy.ts",
    "./map/*": "./src/map/*.ts",
    "./testing/discovery": "./src/testing/discovery.ts"
