{
  "name": "@rebuildingamerica/atlas-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./layout/page-layout": "./src/layout/page-layout.tsx",
    "./layout/auth-flow-frame": "./src/layout/auth-flow-frame.tsx",
