{
  "permissions": {
    "allow": [
      "Bash(git restore --staged*)",
      "Bash(*git restore --staged*)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(*--no-verify*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git stash*)",
      "Bash(git reset*)",
      "Bash(git checkout -- *)",
      "Bash(git clean*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git merge*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(*git stash drop*)",
      "Bash(*git stash clear*)",
      "Bash(*git stash*)",
      "Bash(*git reset*)",
      "Bash(*&& git stash*)",
      "Bash(*; git stash*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check/agent_policy_hook.py\"",
            "statusMessage": "Checking Atlas agent policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check/agent_policy_hook.py\"",
            "statusMessage": "Checking Atlas file placement"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check/agent_policy_hook.py\"",
            "statusMessage": "Checking Atlas file placement"
          }
        ]
      }
    ]
  }
}
