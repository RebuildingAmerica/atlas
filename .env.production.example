# ============================================
# The Atlas - Production Environment Configuration
# ============================================
# For Cloud Run deployment, these are set as env vars via the deploy workflow.
# This file documents what's needed.

# Public routing
ATLAS_PUBLIC_URL=https://atlas.rebuildingus.org
ATLAS_API_URL=https://atlas-api.rebuildingus.org
ATLAS_PDS_PUBLIC_URL=https://atlas-pds.rebuildingus.org
ATLAS_PDS_HOSTNAME=atlas-pds.rebuildingus.org
ATLAS_PDS_ADMIN_PASSWORD=replace-with-the-hosted-pds-admin-password

# Mintlify deployment origin used by Vercel to proxy atlas.rebuildingus.org/docs
ATLAS_DOCS_URL=https://your-subdomain.mintlify.dev
# Does the Rebuilding America Project run this instance? Controls whether
# Atlas's own billing catalog and staff review authority apply.
ATLAS_MANAGED=true
# Does this instance have accounts? False means one operator, no sign-in.
ATLAS_MULTI_USER=true

# OAuth audience claim — identifies the resource server that tokens are issued for.
ATLAS_AUTH_JWT_AUDIENCES=https://atlas.rebuildingus.org/mcp,https://atlas-api.rebuildingus.org

# Backend runtime
ENVIRONMENT=production
LOG_LEVEL=info
DATABASE_BACKEND=postgres
ENABLE_OPENAPI_SPEC=true
ATLAS_ANON_RATE_LIMIT_ENABLED=true
ATLAS_ANON_RATE_LIMIT_READS_PER_MINUTE=30
ATLAS_ANON_RATE_LIMIT_WRITES_PER_MINUTE=10
ATLAS_ANON_RATE_LIMIT_TOTAL_PER_HOUR=120
ATLAS_ANON_CREDENTIAL_RATE_LIMIT_PER_MINUTE=60
ATLAS_ANON_CREDENTIAL_RATE_LIMIT_TOTAL_PER_HOUR=600
ATLAS_TRUSTED_PROXY_HOPS=1
ATLAS_TRUST_UNSIGNED_FORWARD_HEADERS=false
ATLAS_EDGE_ORIGIN_SECRET=replace-with-a-long-random-edge-origin-secret
PDS_ADMIN_PASSWORD=replace-with-a-long-random-pds-admin-password
PDS_JWT_SECRET=replace-with-a-long-random-pds-jwt-secret
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=replace-with-a-64-hex-character-private-key
PDS_DID_PLC_URL=https://plc.directory
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_PORT=2583

# Database — Neon PostgreSQL (production) or sqlite:///data/atlas.db (local)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/atlas?sslmode=require

# API keys
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
SEARCH_API_KEY=

# Auth
ATLAS_AUTH_API_KEY_INTROSPECTION_URL=https://atlas.rebuildingus.org/api/auth/internal/api-key
ATLAS_AUTH_MEMBERSHIP_URL=https://atlas.rebuildingus.org
ATLAS_AUTH_INTERNAL_SECRET=replace-with-a-long-random-secret
# Anyone may create an account. Set to "false" to restrict sign-up to the
# operator allowlist and pending invitations.
ATLAS_AUTH_OPEN_REGISTRATION=true
ATLAS_OPERATOR_ALLOWED_EMAILS=

# MCP widgets — rarely needed. Only set this if built widget assets don't
# live at either of resolve_widget_asset_dir()'s default locations (this
# Docker image's co-located directory, or the monorepo dev build output).
ATLAS_MCP_WIDGET_ASSETS_DIR=

# Email
ATLAS_EMAIL_PROVIDER=resend
ATLAS_EMAIL_FROM=Atlas <hello@atlas.rebuildingus.org>
ATLAS_EMAIL_RESEND_API_KEY=replace-with-your-resend-api-key
ATLAS_EMAIL_CAPTURE_URL=

# Stripe — `STRIPE_API_KEY=rk_live_... pnpm setup:prod` fills these from Stripe live mode.
STRIPE_API_KEY=rk_live_replace_with_your_live_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_live_webhook_secret
STRIPE_ATLAS_CATALOG=

# Service routing (Cloud Run)
# For hosted app deployments (for example Vercel), set this to the public Atlas
# API origin the app should proxy browser-visible `/api/*` requests to.
ATLAS_SERVER_API_PROXY_TARGET=https://atlas-api.rebuildingus.org

# CORS
CORS_ORIGINS=["https://atlas.rebuildingus.org"]
