# Public endpoint. The hostname must resolve to the PDS edge route and use TLS.
ATLAS_PDS_PUBLIC_URL=https://pds.atlas.localhost
ATLAS_PDS_HOSTNAME=pds.atlas.localhost
# Host path backed by the persistent disk when the service runs outside the
# root development Compose stack.
ATLAS_PDS_DATA_DIRECTORY=/var/lib/atlas-pds

# Supply unique secrets through the deployment environment; these example values
# are intentionally unusable outside local development.
PDS_ADMIN_PASSWORD=replace-with-a-local-pds-admin-password
PDS_JWT_SECRET=replace-with-a-long-random-pds-jwt-secret
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=replace-with-a-64-hex-character-private-key

# Protocol and persistent storage settings. Atlas never reads this volume.
PDS_DID_PLC_URL=https://plc.directory
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_PORT=2583
