{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "atlas-web-candidate",
  "main": "worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../app/.output/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": false
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": { "ATLAS_WEB_ORIGIN_URL": "" },
  "secrets": { "required": ["ATLAS_WEB_ORIGIN_SECRET"] },
  "env": {
    "staging": { "name": "atlas-web-staging", "vars": { "ATLAS_WEB_ORIGIN_URL": "" }, "secrets": { "required": ["ATLAS_WEB_ORIGIN_SECRET"] } },
    "production": { "name": "atlas-web", "vars": { "ATLAS_WEB_ORIGIN_URL": "" }, "secrets": { "required": ["ATLAS_WEB_ORIGIN_SECRET"] } }
  }
}
