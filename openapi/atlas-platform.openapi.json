{
  "components": {
    "schemas": {
      "CloudBillingExportPosture": {
        "description": "Cloud Billing BigQuery export connection status.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "enum": [
              "connected",
              "not_connected",
              "not_configured"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "detail"
        ],
        "title": "CloudBillingExportPosture",
        "type": "object"
      },
      "CloudCostGuardrail": {
        "description": "One operator-facing cost guardrail status.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "posture": {
            "enum": [
              "pass",
              "warn",
              "block"
            ],
            "title": "Posture",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "posture",
          "detail"
        ],
        "title": "CloudCostGuardrail",
        "type": "object"
      },
      "CloudCostPostureResponse": {
        "description": "Operator cloud-cost posture summary.",
        "properties": {
          "billing_export": {
            "$ref": "#/components/schemas/CloudBillingExportPosture"
          },
          "discovery_spend": {
            "$ref": "#/components/schemas/DiscoverySpendPosture"
          },
          "external_fixed_costs": {
            "$ref": "#/components/schemas/ExternalFixedCostsPosture"
          },
          "generated_at": {
            "title": "Generated At",
            "type": "string"
          },
          "guardrails": {
            "items": {
              "$ref": "#/components/schemas/CloudCostGuardrail"
            },
            "title": "Guardrails",
            "type": "array"
          },
          "posture": {
            "enum": [
              "pass",
              "warn",
              "block"
            ],
            "title": "Posture",
            "type": "string"
          }
        },
        "required": [
          "generated_at",
          "posture",
          "discovery_spend",
          "billing_export",
          "external_fixed_costs",
          "guardrails"
        ],
        "title": "CloudCostPostureResponse",
        "type": "object"
      },
      "DiscoverySpendPosture": {
        "description": "Discovery cost-ledger spend and configured ceilings.",
        "properties": {
          "daily_ceiling_usd": {
            "title": "Daily Ceiling Usd",
            "type": "number"
          },
          "estimated_daily_usd": {
            "description": "Estimated discovery spend in the last day.",
            "title": "Estimated Daily Usd",
            "type": "number"
          },
          "kill_switch_enabled": {
            "title": "Kill Switch Enabled",
            "type": "boolean"
          },
          "posture": {
            "enum": [
              "pass",
              "warn",
              "block"
            ],
            "title": "Posture",
            "type": "string"
          },
          "run_ceiling_usd": {
            "title": "Run Ceiling Usd",
            "type": "number"
          }
        },
        "required": [
          "estimated_daily_usd",
          "daily_ceiling_usd",
          "run_ceiling_usd",
          "kill_switch_enabled",
          "posture"
        ],
        "title": "DiscoverySpendPosture",
        "type": "object"
      },
      "ExternalFixedCostsPosture": {
        "description": "External provider fixed-cost accounting status.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "enum": [
              "connected",
              "not_connected",
              "not_configured"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "detail"
        ],
        "title": "ExternalFixedCostsPosture",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerificationListResponse": {
        "description": "Response payload for list of verification records.",
        "properties": {
          "organization_id_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization Id Filter"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/VerificationRecordResponse"
            },
            "title": "Records",
            "type": "array"
          },
          "segment_filter": {
            "anyOf": [
              {
                "enum": [
                  "student",
                  "independent_journalist",
                  "grassroots_nonprofit",
                  "civic_tech_worker"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segment Filter"
          },
          "status_filter": {
            "anyOf": [
              {
                "enum": [
                  "pending",
                  "verified",
                  "rejected",
                  "expired"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Filter"
          },
          "total": {
            "description": "Total number of records matching filters",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "records",
          "total"
        ],
        "title": "VerificationListResponse",
        "type": "object"
      },
      "VerificationRecordResponse": {
        "description": "Response payload for a verification record.",
        "properties": {
          "id": {
            "description": "Verification record ID",
            "title": "Id",
            "type": "string"
          },
          "method": {
            "description": "Verification method used",
            "enum": [
              "portfolio",
              "school_email",
              "ein_submission",
              "mission_statement"
            ],
            "title": "Method",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "organization_id": {
            "description": "Workspace receiving the verified discount",
            "title": "Organization Id",
            "type": "string"
          },
          "segment": {
            "enum": [
              "student",
              "independent_journalist",
              "grassroots_nonprofit",
              "civic_tech_worker"
            ],
            "title": "Segment",
            "type": "string"
          },
          "status": {
            "description": "Verification status",
            "enum": [
              "pending",
              "verified",
              "rejected",
              "expired"
            ],
            "title": "Status",
            "type": "string"
          },
          "submitted_at": {
            "description": "ISO timestamp of submission",
            "title": "Submitted At",
            "type": "string"
          },
          "user_id": {
            "description": "User ID who submitted the verification",
            "title": "User Id",
            "type": "string"
          },
          "verification_data": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Verification Data",
            "type": "object"
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO timestamp of verification",
            "title": "Verified At"
          }
        },
        "required": [
          "id",
          "user_id",
          "organization_id",
          "segment",
          "status",
          "method",
          "submitted_at"
        ],
        "title": "VerificationRecordResponse",
        "type": "object"
      },
      "VerificationUpdateRequest": {
        "description": "Request to update verification status.",
        "properties": {
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "status": {
            "enum": [
              "verified",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "VerificationUpdateRequest",
        "type": "object"
      },
      "VerificationUpdateResponse": {
        "description": "Response after updating verification.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "record": {
            "$ref": "#/components/schemas/VerificationRecordResponse"
          },
          "status": {
            "enum": [
              "verified",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "message",
          "record"
        ],
        "title": "VerificationUpdateResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Routes the Atlas platform admin calls on a managed deployment. Each request carries the admin app's Ed25519 token and the operator's Cloudflare Access assertion.",
    "title": "Atlas platform API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/platform/cloud-costs": {
      "get": {
        "description": "Return operator-only Atlas cloud-cost posture and guardrail status.",
        "operationId": "getCloudCostPosture",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudCostPostureResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get cloud cost posture",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/discount-verifications": {
      "get": {
        "description": "List discount verification requests for manual review.",
        "operationId": "listVerifications",
        "parameters": [
          {
            "in": "query",
            "name": "organization_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Organization Id"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "pending",
                    "verified",
                    "rejected",
                    "expired"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "segment",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "student",
                    "independent_journalist",
                    "grassroots_nonprofit",
                    "civic_tech_worker"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Segment"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List discount verifications",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/discount-verifications/{verification_id}": {
      "patch": {
        "description": "Decide a pending discount request, then email the applicant through the app. A 409 means it was already decided. A 502 means the email was not sent, so the request was put back to pending to be decided again.",
        "operationId": "updateVerification",
        "parameters": [
          {
            "in": "path",
            "name": "verification_id",
            "required": true,
            "schema": {
              "title": "Verification Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationUpdateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update discount verification",
        "tags": [
          "platform"
        ]
      }
    }
  }
}
