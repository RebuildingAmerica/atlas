      "PlatformSwitchResponse": {
        "description": "One switch and its last change.",
        "properties": {
          "changed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When it last changed",
            "title": "Changed At"
          },
          "changed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
