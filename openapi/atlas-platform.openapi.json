            },
            "title": "Events",
            "type": "array"
          },
          "request": {
            "$ref": "#/components/schemas/WaitlistRequest"
          }
        },
        "required": [
          "request",
          "deliveries",
          "events"
        ],
        "title": "WaitlistDetail",
        "type": "object"
      },
      "WaitlistDetailInput": {
        "additionalProperties": false,
        "description": "One request to review.",
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "WaitlistDetailInput",
        "type": "object"
      },
      "WaitlistEvent": {
        "additionalProperties": false,
        "description": "A request decision attributed to its operator.",
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "actorId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actorid"
          },
          "createdAt": {
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "requestId",
          "action",
          "actorId",
          "createdAt"
        ],
        "title": "WaitlistEvent",
        "type": "object"
      },
      "WaitlistInvitations": {
        "additionalProperties": false,
        "description": "Invitation outcomes, preserving partial success.",
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/WaitlistInviteResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "WaitlistInvitations",
        "type": "object"
      },
      "WaitlistInviteInput": {
        "additionalProperties": false,
        "description": "Up to fifty exact recipients for one reviewed batch.",
        "properties": {
          "ids": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Ids",
            "type": "array"
          }
        },
        "required": [
          "ids"
        ],
        "title": "WaitlistInviteInput",
        "type": "object"
      },
      "WaitlistInviteResult": {
        "additionalProperties": false,
        "description": "A recipient's independent invitation outcome.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "message"
        ],
        "title": "WaitlistInviteResult",
        "type": "object"
      },
      "WaitlistQueue": {
        "additionalProperties": false,
        "description": "The private queue and purchase availability.",
        "properties": {
          "availability": {
            "$ref": "#/components/schemas/WaitlistAvailability"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/WaitlistRecord"
            },
            "title": "Records",
            "type": "array"
          }
        },
        "required": [
          "records",
          "availability"
        ],
        "title": "WaitlistQueue",
        "type": "object"
      },
      "WaitlistRecord": {
        "additionalProperties": false,
        "description": "A queue row with email outcomes.",
        "properties": {
          "deliveries": {
            "items": {
              "$ref": "#/components/schemas/WaitlistDelivery"
            },
            "title": "Deliveries",
            "type": "array"
          },
          "request": {
            "$ref": "#/components/schemas/WaitlistRequest"
          }
        },
        "required": [
          "request",
          "deliveries"
        ],
        "title": "WaitlistRecord",
        "type": "object"
      },
      "WaitlistRequest": {
        "additionalProperties": false,
        "description": "An applicant's retained request.",
        "properties": {
          "confirmedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmedat"
          },
          "createdAt": {
            "title": "Createdat",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "intendedUse": {
            "title": "Intendeduse",
            "type": "string"
          },
          "interval": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval"
          },
          "invitedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invitedat"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "organization": {
            "title": "Organization",
            "type": "string"
          },
          "product": {
            "enum": [
              "atlas_pro",
              "atlas_team",
              "atlas_research_pass"
            ],
            "title": "Product",
            "type": "string"
          },
          "purchasedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchasedat"
          },
          "status": {
            "enum": [
              "unconfirmed",
              "waiting",
              "invited",
              "withdrawn",
              "revoked"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "organization",
          "intendedUse",
          "product",
          "interval",
          "status",
          "createdAt",
          "confirmedAt",
          "invitedAt",
          "purchasedAt"
        ],
        "title": "WaitlistRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Routes the Atlas platform admin calls on a managed deployment. Each request carries the admin app's Ed25519 token and the operator's Cloudflare Access assertion.",
    "title": "Atlas platform API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/platform/accounts/lookup": {
      "post": {
        "description": "Find an account by email, or a workspace by slug, with its members, products and why it holds them, purchases, refunds and discount requests. Read-only; every lookup is audited.",
        "operationId": "lookupAccount",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountLookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLookupResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Look up an account or workspace",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/cloud-costs": {
      "get": {
        "description": "Return operator-only Atlas cloud-cost posture and guardrail status.",
        "operationId": "getCloudCostPosture",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudCostPostureResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get cloud cost posture",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/discount-verifications": {
      "get": {
        "description": "List discount verification requests for manual review.",
        "operationId": "listVerifications",
        "parameters": [
          {
            "in": "query",
            "name": "organization_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Organization Id"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "pending",
                    "verified",
                    "rejected",
                    "expired"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "segment",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "student",
                    "independent_journalist",
                    "grassroots_nonprofit",
                    "civic_tech_worker"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Segment"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List discount verifications",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/discount-verifications/{verification_id}": {
      "patch": {
        "description": "Decide a pending discount request, then email the applicant through the app. A 409 means it was already decided. A 502 means the email was not sent, so the request was put back to pending to be decided again.",
        "operationId": "updateVerification",
        "parameters": [
          {
            "in": "path",
            "name": "verification_id",
            "required": true,
            "schema": {
              "title": "Verification Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationUpdateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update discount verification",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/switches": {
      "get": {
        "description": "Return every switch, its state, and who last changed it and why.",
        "operationId": "listPlatformSwitches",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformSwitchCollectionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List platform switches",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/switches/{name}": {
      "put": {
        "description": "Engage or release one switch. discovery_spend stops every discovery run from spending; checkout stops the pricing page from selling. Takes effect within a minute.",
        "operationId": "setPlatformSwitch",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "enum": [
                "discovery_spend",
                "checkout"
              ],
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlatformSwitchUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformSwitchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Engage or release a platform switch",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/waitlist": {
      "post": {
        "description": "Read applicants only for a verified platform operator.",
        "operationId": "listWaitlistRequests",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistQueue"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Waitlist",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/waitlist/action": {
      "post": {
        "description": "Withdraw permission, resend an invitation or retry a retained email.",
        "operationId": "actOnWaitlistRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistActionInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistActionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Act On Waitlist",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/waitlist/detail": {
      "post": {
        "description": "Review a retained request and its operator-attributed history.",
        "operationId": "loadWaitlistStaffDetail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistDetailInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Waitlist Detail",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/platform/waitlist/invite": {
      "post": {
        "description": "Invite the exact reviewed recipients through the existing durable mailer.",
        "operationId": "inviteWaitlistRequests",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistInviteInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistInvitations"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Invite Waitlist",
        "tags": [
          "platform"
        ]
      }
    }
  }
}
