# ============================================
# The Atlas - Environment Configuration
# ============================================

# Runtime
ENVIRONMENT=dev
LOG_LEVEL=info
# Does the Rebuilding America Project run this instance? Controls whether
# Atlas's own billing catalog and staff review authority apply.
ATLAS_MANAGED=true
# Does this instance have accounts? False means one operator, no sign-in.
ATLAS_MULTI_USER=true
ATLAS_PUBLIC_URL=https://atlas.localhost
ATLAS_API_URL=https://api.atlas.localhost
ATLAS_PDS_PUBLIC_URL=https://pds.atlas.localhost
ATLAS_PDS_HOSTNAME=pds.atlas.localhost
ATLAS_PDS_ADMIN_PASSWORD=replace-with-a-local-pds-admin-password
ATLAS_AUTH_JWT_AUDIENCES=https://atlas.localhost/mcp,https://api.atlas.localhost
ENABLE_OPENAPI_SPEC=true
ATLAS_ANON_RATE_LIMIT_ENABLED=true
ATLAS_ANON_RATE_LIMIT_READS_PER_MINUTE=30
ATLAS_ANON_RATE_LIMIT_WRITES_PER_MINUTE=10
ATLAS_ANON_RATE_LIMIT_TOTAL_PER_HOUR=120
ATLAS_ANON_CREDENTIAL_RATE_LIMIT_PER_MINUTE=60
ATLAS_ANON_CREDENTIAL_RATE_LIMIT_TOTAL_PER_HOUR=600
ATLAS_TRUSTED_PROXY_HOPS=1
ATLAS_TRUST_UNSIGNED_FORWARD_HEADERS=false
ATLAS_EDGE_ORIGIN_SECRET=replace-with-a-local-edge-secret
PDS_ADMIN_PASSWORD=replace-with-a-local-pds-admin-password
PDS_JWT_SECRET=replace-with-a-long-random-pds-jwt-secret
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=replace-with-a-64-hex-character-private-key
PDS_DID_PLC_URL=https://plc.directory
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_PORT=2583

# Backend — DATABASE_BACKEND must match DATABASE_URL scheme.
# Use "sqlite" for local dev, "postgres" for staging/production.
DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite:///atlas.db
ANTHROPIC_API_KEY=your-anthropic-api-key
SEARCH_API_KEY=

# Frontend
VITE_API_URL=https://api.atlas.localhost
ATLAS_SERVER_API_PROXY_TARGET=https://api.atlas.localhost
ATLAS_DOCS_URL=
ATLAS_AUTH_INTERNAL_SECRET=replace-with-a-local-dev-secret
# Anyone may create an account. Set to "false" to restrict sign-up to the
# operator allowlist and pending invitations.
ATLAS_AUTH_OPEN_REGISTRATION=true
ATLAS_AUTH_API_KEY_INTROSPECTION_URL=https://atlas.localhost/api/auth/internal/api-key
ATLAS_AUTH_MEMBERSHIP_URL=https://atlas.localhost
ATLAS_OPERATOR_ALLOWED_EMAILS=

# MCP widgets — rarely needed. Only set this if built widget assets don't
# live at either of resolve_widget_asset_dir()'s default locations (a
# production Docker-populated directory, or the monorepo dev build output).
ATLAS_MCP_WIDGET_ASSETS_DIR=

ATLAS_EMAIL_PROVIDER=capture
ATLAS_EMAIL_FROM=Atlas <hello@atlas.localhost>
ATLAS_EMAIL_RESEND_API_KEY=
ATLAS_EMAIL_CAPTURE_URL=http://127.0.0.1:8025/messages

# Stripe — `pnpm run setup` fills these from Stripe test mode.
# Run `pnpm stripe:listen` while testing checkout webhooks locally.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ATLAS_CATALOG=

# CORS
CORS_ORIGINS=["https://atlas.localhost"]
