{
  "name": "@rebuildingamerica/atlas-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "sh ./scripts/portless-reset.sh",
    "dev": "ATLAS_MANAGED=true ATLAS_MULTI_USER=true turbo run dev e2e:mail",
    "dev:reset": "sh ./scripts/dev-reset.sh",
    "setup": "tsx scripts/bootstrap/cold-start.ts",
    "setup:local": "tsx scripts/bootstrap/cold-start.ts --local-only",
    "setup:staging": "tsx scripts/bootstrap/cold-start.ts --target staging",
    "setup:prod": "tsx scripts/bootstrap/cold-start.ts --target prod --live",
    "predev:local": "sh ./scripts/portless-reset.sh",
    "dev:local": "ATLAS_MANAGED=false ATLAS_MULTI_USER=false turbo run dev",
    "portless:reset": "sh ./scripts/portless-reset.sh",
    "secrets:update-baseline": "sh ./scripts/secrets-update-baseline.sh",
    "secrets:scan": "sh ./scripts/secrets-scan.sh",
    "openapi": "sh ./scripts/openapi-export.sh",
    "asyncapi": "uv --directory ./api run python -m atlas.domains.firehose.asyncapi",
    "predocs:dev": "sh ./scripts/portless-reset.sh",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:validate": "pnpm --filter docs exec mint validate",
    "docs:broken-links": "pnpm --filter docs exec mint broken-links",
    "api:test": "turbo run @rebuildingamerica/atlas-api#test",
    "python:test": "turbo run @rebuildingamerica/atlas-shared#test @rebuildingamerica/atlas-discovery-engine#test @rebuildingamerica/atlas-scout#test @rebuildingamerica/atlas-api#test",
    "quality": "turbo run typecheck lint test",
    "test:ci": "turbo run test",
    "test:coverage": "turbo run @rebuildingamerica/atlas-shared#test @rebuildingamerica/atlas-discovery-engine#test @rebuildingamerica/atlas-scout#test @rebuildingamerica/atlas-api#test @rebuildingamerica/atlas-app#test",
    "test:e2e": "pnpm --filter @rebuildingamerica/atlas-app run test:acceptance",
    "test:e2e:headed": "pnpm --filter @rebuildingamerica/atlas-app run test:acceptance:headed",
    "contract:test": "sh ./scripts/contract-test.sh",
    "compose:validate": "sh ./scripts/compose-validate.sh",
    "pds:test": "node --test services/atproto-pds/test-config.mjs scripts/deploy/pds-release.test.mjs",
    "scout-dev:install": "bash ./install-scout-dev.sh",
    "scout-dev:uninstall": "bash ./uninstall-scout-dev.sh",
    "scout-dev:test": "uv --directory ./scout run pytest --no-cov tests/e2e/test_scout_dev_installer.py -q",
    "release:homebrew": "sh scripts/release/scout-homebrew.sh",
    "release:homebrew:test": "sh scripts/release/tests/test-scout-homebrew.sh",
    "deploy:test": "node --test scripts/deploy/*.test.mjs scripts/ci/*.test.mjs",
    "actionlint": "if command -v actionlint >/dev/null 2>&1; then actionlint; else go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12; fi",
    "turbo:validate": "node ./scripts/validate-turbo-selectors.mjs",
    "e2e:api": "uv --directory ./api run python -m atlas.seed_profiles --database-url ${DATABASE_URL:-sqlite:///atlas.db} && uv --directory ./api run python -m atlas.main",
    "seed:profiles": "uv --directory ./api run python -m atlas.seed_profiles",
    "demo:briefing-room": "uv --directory ./api run python -m atlas.seed_briefing_room_demo",
    "demo:briefing-room:staging": "tsx --tsconfig app/tsconfig.json app/scripts/provision-briefing-room-workspace.ts && if [ \"${ATLAS_DEMO_DATA:-briefing_room}\" != \"none\" ]; then uv --directory ./api run python -m atlas.seed_briefing_room_demo --org-id ${ATLAS_DEMO_ORG_ID:-briefing-room-demo} --user-id ${ATLAS_DEMO_USER_ID:-briefing-room-operator}; fi",
    "mcp:gen-publisher-key": "node ./scripts/mcp-gen-publisher-key.mjs",
    "mcp:setup": "tsx scripts/bootstrap/cold-start.ts --mcp-registry",
    "verify": "sh ./scripts/deploy/prod-verify.sh",
    "lint": "eslint scripts/bootstrap --max-warnings 0",
    "lint:fix": "eslint scripts/bootstrap --fix",
    "format": "prettier --write 'scripts/**/*.ts'",
    "format:check": "prettier --check 'scripts/**/*.ts'",
    "bootstrap": "tsx scripts/bootstrap/cold-start.ts",
    "bootstrap:test": "sh -c 'node --import tsx --test $(find scripts/bootstrap -name \"*.test.ts\" | sort)'",
    "stripe:verify:local": "tsx scripts/bootstrap/products/atlas/verify.ts --target local",
    "stripe:verify:staging": "tsx scripts/bootstrap/products/atlas/verify.ts --target staging",
    "stripe:verify:prod": "tsx scripts/bootstrap/products/atlas/verify.ts --target prod --live",
    "stripe:verify:ci": "tsx scripts/ci/verify-stripe-runtime-catalog.ts",
    "stripe:listen": "tsx scripts/bootstrap/products/atlas/listen.ts",
    "doctor": "tsx scripts/bootstrap/cold-start.ts --doctor"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@rebuildingamerica/eslint-config": "workspace:*",
    "@rebuildingamerica/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "picocolors": "catalog:",
    "portless": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "stripe": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "vercel": "^54.21.1"
  }
}
